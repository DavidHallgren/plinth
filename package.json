{
  "name": "plinth",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A local-first screenshot composition tool.",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "build": "bun scripts/build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test",
    "tool": "bun src/cli/index.ts",
    "generate:favicon": "bun run scripts/generate-favicon.ts",
    "postinstall": "bun scripts/generate-styles.ts",
    "predev": "bun scripts/generate-styles.ts",
    "prestart": "bun scripts/generate-styles.ts",
    "prebuild": "bun scripts/generate-styles.ts --minify"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/lora": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@fontsource-variable/noto-sans-jp": "5.3.0",
    "@fontsource-variable/noto-sans-kr": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@fontsource-variable/noto-sans-tc": "5.3.0",
    "@fontsource-variable/quicksand": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "fontkit": "2.0.4",
    "konva": "^10.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-konva": "^19.2.4",
    "react-router": "^7.18.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.11",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.3"
  }
}
