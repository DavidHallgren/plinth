{
  "name": "plinth",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first screenshot composition tool.",
  "type": "module",
  "scripts": {
    "dev": "bun src/tooling.ts dev",
    "start": "bun src/tooling.ts start",
