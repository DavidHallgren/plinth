{
  "name": "plinth",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A local-first screenshot composition tool.",
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "start": "bun src/server.ts",
    "build": "bun build --compile src/server.ts --outfile dist/plinth",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test",
    "tool": "bun src/cli/index.ts",
    "postinstall": "bun scripts/generate-styles.ts",
    "predev": "bun scripts/generate-styles.ts",
    "prestart": "bun scripts/generate-styles.ts",
    "prebuild": "bun scripts/generate-styles.ts --minify"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "konva": "^10.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-konva": "^19.2.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.11",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.3"
  }
}
